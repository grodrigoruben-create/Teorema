<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/Titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Teorema de Pitágoras"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="150dp"
        android:layout_height="100dp"
        android:src="@drawable/inicial"
        android:contentDescription="Triángulo del teorema de Pitágoras"
        android:scaleType="fitCenter"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/Titulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/Texto1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Qué quieres hacer?"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/imageView"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="32dp" />

    <Spinner
        android:id="@+id/Opcion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/Texto1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/Dato1"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:hint="Cateto a"
        android:inputType="numberDecimal"
        android:layout_marginStart="48dp"
        android:layout_marginTop="64dp"
        app:layout_constraintTop_toBottomOf="@id/Opcion"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/Dato2"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:hint="Cateto b"
        android:inputType="numberDecimal"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/Opcion"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/Resolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resolver"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toBottomOf="@id/Dato1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/Resultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/Resolver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
